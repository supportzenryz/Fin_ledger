# Local: copy to .env.local. Cloudflare: see README (NEXT_PUBLIC_* are build variables; the rest are runtime secrets).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # secret, server only

# Your deployed address, used in the links sent to customers
NEXT_PUBLIC_APP_URL=https://lendbook.<your-subdomain>.workers.dev

# Any long random string; the Cloudflare cron trigger sends it to /api/cron/daily
CRON_SECRET=

# Email option 1 (free, no domain): your Gmail via Google Apps Script, 100/day. See docs/gmail-apps-script.gs.
GMAIL_SCRIPT_URL=                     # the web app URL ending in /exec
GMAIL_SCRIPT_SECRET=                  # same text as the SECRET script property
MAIL_FROM_NAME="Sri Finance"

# Email option 2 (later, needs your own domain): Resend, 100/day. Used only if Gmail is not set.
RESEND_API_KEY=
MAIL_FROM_EMAIL=loans@yourdomain.com

# WhatsApp Cloud API (Meta). Leave empty until set up; the app then shows one-tap wa.me buttons.
WHATSAPP_TOKEN=                       # permanent System User token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WA_TEMPLATE_LANG=en
# Template names, if you named them differently in Meta
WA_TEMPLATE_DUE=lendbook_due_reminder
WA_TEMPLATE_OVERDUE=lendbook_overdue
WA_TEMPLATE_RECEIPT=lendbook_payment_received
WA_TEMPLATE_AGREEMENT=lendbook_agreement
